# 사용자 요청 반영: Docker compose에서 주입할 외부 환경변수 파일 템플릿
# 사용 방법: 이 파일을 consumer.env로 복사한 뒤 값 수정

MONGO_URI=mongodb://mongodb:27017/commentdb
REDIS_URL=redis://redis:6379

# Redis Stream Configuration
STREAM_PATTERN=chat:stream:room:*
GROUP_NAME=comment-group
CONSUMER_NAME=comment-worker-1
DISCOVERY_INTERVAL_MS=3000
BATCH_INTERVAL_MS=100
MAX_BATCH_SIZE=10000
READ_COUNT=100
READ_BLOCK_MS=1500

# Summary Service Configuration
SUMMARY_SERVICE_URL=http://ai-chat-summary:8000
SUMMARY_AUTO_ENABLED=false
SUMMARY_BATCH_SIZE=500
SUMMARY_MESSAGE_LIMIT=500
SUMMARY_SERVICE_TIMEOUT_MS=30000
SUMMARY_MANUAL_WINDOW_MINUTES=5
SUMMARY_MANUAL_MIN_MESSAGES=10
SUMMARY_MANUAL_MAX_MESSAGES=100
ROOM_SERVICE_URL=http://backend-room-service:8082/api/room

# HTTP Server Configuration
PORT=3000
