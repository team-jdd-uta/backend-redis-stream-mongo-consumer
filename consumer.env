# 사용자 요청 반영: Docker compose consumer가 실제로 읽는 외부 환경변수 파일
# 필요 시 아래 값을 직접 수정하여 consume 동작(예: READ_BLOCK_MS)을 조정

MONGO_URI=mongodb://mongodb:27017/commentdb
REDIS_URL=redis://redis:6379

# Redis Stream Configuration
STREAM_PATTERN=chat:stream:room:*
GROUP_NAME=comment-group
CONSUMER_NAME=comment-worker-1
DISCOVERY_INTERVAL_MS=3000
BATCH_INTERVAL_MS=100
MAX_BATCH_SIZE=10000
READ_COUNT=100
READ_BLOCK_MS=1500
